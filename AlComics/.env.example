# AIComics v2.0 — Environment Configuration
# 复制本文件为 .env 并填入你的 API Key
# cp .env.example .env

# ── JWT Secret (必填) ──────────────────────────
# 生成方法: openssl rand -hex 32
AICOMICS_JWT_SECRET=change-me-to-a-random-secret

# ── AI 视频生成 API Key ────────────────────────
SEEDANCE_API_KEY=

# ── 外部服务地址 (Docker Compose 默认值) ────────
OLLAMA_BASE_URL=http://ollama:11434
COMFY_URL=http://comfyui:8188

# ── 端口配置 ───────────────────────────────────
AICOMICS_PORT=8080
BACKEND_PORT=8000
OLLAMA_PORT=11434
COMFYUI_PORT=8188

# ── 数据路径 ───────────────────────────────────
AICOMICS_ROOT=/app
AICOMICS_DB=/app/data/aicomics.db
AICOMICS_DATA=/app/data

# ── CORS (逗号分隔多个来源) ────────────────────
AICOMICS_CORS_ORIGINS=http://localhost:8080
