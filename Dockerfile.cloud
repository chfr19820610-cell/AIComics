# AIComics Cloud Edition — lightweight Docker image (< 500MB)
# No ComfyUI, no local models. All providers via API.
# Usage: AICOMIC_CLOUD=1 docker-compose -f docker-compose.cloud.yml up

FROM python:3.12-slim AS base

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy all source first (pip install needs src/ for package discovery)
COPY pyproject.toml ./
COPY src/ ./src/
COPY config/ ./config/
COPY main.py ./
COPY web/ ./web/

# Install dependencies (non-editable for cloud image)
RUN pip install --no-cache-dir .

ENV AICOMIC_CLOUD=1
ENV PYTHONPATH=/app/src

EXPOSE 7860

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
