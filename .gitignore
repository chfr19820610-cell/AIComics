# v1.0.0 补充 — 重资产和内部目录排除
# ComfyUI runtime (105G — 模型/checkpoints/venv)
local_providers/comfyui_runtime/
# ComfyUI workflows 保留（小文件，配置用）
# company/ 内部文档不开源
company/
# ComfyUI venv
local_providers/comfyui_runtime/ComfyUI/.venv/
# egg-info
*.egg-info/
# 音频素材（大文件）
audio/
# 工具脚本（内部用）
scripts/skill_master_check.py

# 运行时日志与报告（2026-11-13 补：旧规则只忽略 *.json，导致 comfyui_service_*.log 会误入库）
reports/*.log
reports/git-recovery/
reports/pip-freeze-*.txt
# 编辑器/AI 工具留下的 package 备份
*.bak-codex-major
*.bak-*
# 内部方法论 SOP（基于全网资料整理的产线秘籍，不随开源仓库发布）
docs/AI*SOP.md
# ComfyUI runtime 软链（指向 112G 的 comfyui_runtime，克隆后为断链，不入库）
local_providers/comfyui/runtime/
# Piper 语音权重（60MB+，按需下载，不入库；MODEL_CARD/LICENSE_REVIEW.json 保留）
local_providers/piper/models/*.onnx
local_providers/piper/models/*.onnx.json
# g2pw 首次运行下载的中文 BERT 权重缓存（本机缓存，不入库）
g2pW/
