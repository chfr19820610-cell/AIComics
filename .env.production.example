# ── 核心 ────────────────────────────────────────
AICOMIC_WEB_CONFIG_PATH=/app/config/web.production.docker.yaml
AICOMIC_EDITION_CONFIG_PATH=/app/config/edition.production.yaml
AICOMIC_JWT_SECRET=replace-with-at-least-64-random-hex-chars
AICOMIC_NORMAL_USER_PASSWORD=replace-with-creator-password
AICOMIC_STATE_DIR=/app/state
AICOMIC_DATABASE_PATH=/app/state/aicomic_demo.db

# ── ComfyUI ────────────────────────────────────
# 本地 ComfyUI（全栈模式）
AICOMIC_COMFYUI_BASE_URL=http://host.docker.internal:8188

# ── 云端轻量模式 (v2.0) ────────────────────────
# 设为 1 跳过 local_providers，全走 API
# AICOMIC_CLOUD=1

# ── 多机推理 (v2.0) ─────────────────────────────
# 多 GPU 负载均衡（逗号分隔多个 URL）
# AICOMIC_COMFYUI_URLS=http://gpu1:8188,http://gpu2:8188

# ── SaaS API Key (v2.0) ─────────────────────────
# 设为空则禁用 API Key 认证
# AICOMIC_API_KEY_ENABLED=true

# ── YouTube Data API v3 (v2.0) ──────────────────
# 获取: https://console.cloud.google.com/apis/credentials
# AICOMIC_YOUTUBE_CLIENT_SECRET=/path/to/client_secret.json
# AICOMIC_YOUTUBE_CREDENTIALS=/path/to/credentials.json

# ── TikTok (v2.0) ───────────────────────────────
# 通过 social-auto-upload playwright 上传
# AICOMIC_TIKTOK_COOKIE=/path/to/tiktok_cookie.json

# ── Instagram Graph API (v2.0) ──────────────────
# 获取: https://developers.facebook.com/docs/instagram-api
# AICOMIC_INSTAGRAM_ACCESS_TOKEN=
# AICOMIC_INSTAGRAM_ACCOUNT_ID=

# ── 多语言 TTS (v2.0) ───────────────────────────
# edge-tts 免费在线 TTS（无需 key）
# AICOMIC_EDGE_TTS=true
